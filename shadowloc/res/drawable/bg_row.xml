<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#1B2530" />
            <stroke android:width="1dp" android:color="@color/secondary_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#10161E" />
            <stroke android:width="1dp" android:color="#1D2631" />
        </shape>
    </item>
</selector>
